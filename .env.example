# CargoBox — variables de entorno (copiar a .env; el archivo .env NO se sube a GitHub).
# No poner secretos reales en este archivo.

PORT=8000
APP_PORT=8080

# Base de datos.
# Local sin Docker (SQLite):   sqlite:///./cargobox.sqlite3
# Con docker compose:          lo arma docker-compose.yml con las variables POSTGRES_*
# En Render/Railway:           pegar la "Internal Database URL" de su PostgreSQL
DATABASE_URL=sqlite:///./cargobox.sqlite3

POSTGRES_USER=cargobox
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=cargobox
