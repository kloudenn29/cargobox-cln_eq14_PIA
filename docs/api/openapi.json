  "components": {
    "schemas": {
      "ActualizarDireccionDTO": {
        "properties": {
          "nueva_direccion": {
            "$ref": "#/components/schemas/DireccionDTO"
          },
          "rol_solicitante": {
            "type": "string",
            "title": "Rol Solicitante",
            "default": "ATENCION_CLIENTES"
          }
        },
        "type": "object",
        "required": [
          "nueva_direccion"
        ],
        "title": "ActualizarDireccionDTO"
      },
      "AlertaRastreoDTO": {
        "properties": {
          "guia": {
            "type": "string",
            "title": "Guia"
          },
          "estado": {
            "type": "string",
            "title": "Estado"
          },
          "horas_sin_movimiento": {
            "type": "number",
            "title": "Horas Sin Movimiento"
          },
          "notificado_a": {
            "type": "string",
            "title": "Notificado A",
            "default": "ATENCION_CLIENTES"
          }
        },
        "type": "object",
        "required": [
          "guia",
          "estado",
          "horas_sin_movimiento"
        ],
        "title": "AlertaRastreoDTO"
      },
      "AvanzarEnvioDTO": {
        "properties": {
          "destino": {
            "type": "string",
            "title": "Destino",
            "description": "Siguiente estado: CLASIFICADO, EN_TRANSITO, DISTRIBUCION_LOCAL o EN_REPARTO."
          },
          "cedis_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cedis Id",
            "description": "CEDIS donde ocurre el movimiento (opcional)."
          }
        },
        "type": "object",
        "required": [
          "destino"
        ],
        "title": "AvanzarEnvioDTO"
      },
      "CancelarEnvioDTO": {
        "properties": {
          "motivo": {
            "type": "string",
            "title": "Motivo",
            "default": "Solicitud de cancelación por remitente en sucursal"
          }
        },
        "type": "object",
        "title": "CancelarEnvioDTO"
      },
      "DetalleOperacionDTO": {
        "properties": {
          "recurso_id": {
            "type": "string",
            "title": "Recurso Id"
          },
          "cantidad": {
            "type": "integer",
            "title": "Cantidad"
          },
          "precio_unitario": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Precio Unitario",
            "default": "0.00"
          },
          "subtotal": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Subtotal",
            "default": "0.00"
          }
        },
        "type": "object",
        "required": [
          "recurso_id",
          "cantidad"
        ],
        "title": "DetalleOperacionDTO"
      },
      "DictamenIndemnizacionDTO": {
        "properties": {
          "monto_reclamado": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Monto Reclamado"
          },
          "rol_dictaminador": {
